# Environment Configuration for ConformIA Backend Template
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# MongoDB Atlas or local replica set
DATABASE_URL=mongodb://localhost:27017/conformia?retryWrites=true&w=majority

# Redis connection for BullMQ and Cache (Obrigatório: sem senha padrão fraca)
REDIS_URL=redis://:troque_por_senha_forte_do_redis_minimo_32_caracteres_gerada_aleatoriamente@localhost:6379

# Authentication JWT
JWT_SECRET=troque_por_chave_secreta_jwt_acesso_minimo_32_caracteres
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=troque_por_chave_secreta_jwt_refresh_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Initial Administrator Credentials (Mínimo 12 caracteres em produção)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque_por_uma_senha_admin_forte_minimo_12_caracteres

# Transactional Email (Resend API)
RESEND_API_KEY=re_sua_chave_resend_api_aqui
EMAIL_FROM=Conform.AI Laudos <laudos@conformia.med.br>

# AI Providers
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Scraping & MCP
EXTRACTION_MODE=CHEERIO
FIRECRAWL_API_KEY=
MCP_SERVER_URL=http://localhost:8080/mcp

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Telemetry & Worker Metrics (/metrics) - Mandatório em Produção (T02)
MONITORING_API_KEY=troque_por_chave_secreta_de_monitoramento_minimo_32_caracteres
