# Environment Configuration for ConformIA Backend
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# MongoDB Atlas or local replica set
DATABASE_URL=mongodb://localhost:27017/conformia?retryWrites=true&w=majority

# Redis connection for BullMQ and Cache (Obrigatório: sem senha padrão fraca)
REDIS_URL=redis://:DefinaSuaSenhaSeguraAqui123456789!@localhost:6379

# Authentication JWT
JWT_SECRET=conformia-super-secret-jwt-key-minimum-32-chars-2026
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=conformia-refresh-secret-jwt-key-minimum-32-chars-2026
JWT_REFRESH_EXPIRES_IN=7d

# Transactional Email (Resend API)
RESEND_API_KEY=re_123456789_abcdef
EMAIL_FROM=Conform.AI Laudos <laudos@conformia.med.br>

# AI Providers
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Scraping & MCP
EXTRACTION_MODE=CHEERIO
FIRECRAWL_API_KEY=
MCP_SERVER_URL=http://localhost:8080/mcp

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
