datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AUDITOR
  CLIENT
  VIEWER
}

enum ClientStatus {
  ATIVO
  INATIVO
  PENDENTE
  SUSPENSO
}

enum AuditStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum RuleSeverity {
  LEVE
  MEDIA
  GRAVE
  CRITICA
}

enum ExtractionMode {
  PUPPETEER
  CHEERIO
  FALLBACK_AI
  MCP
  FIRECRAWL
}

enum Verdict {
  CONFORME
  PARCIALMENTE_CONFORME
  NAO_CONFORME
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CLIENT)
  clientId     String?   @db.ObjectId
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Client {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  tradeName         String?
  cnpj              String?       @unique
  crmResponsavel    String
  crmUf             String
  rqeResponsavel    String?
  especialidade     String?
  websiteUrl        String
  instagramHandle   String?
  status            ClientStatus  @default(ATIVO)
  phone             String?
  email             String
  users             User[]
  auditReports      AuditReport[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("clients")
}

model AgentModule {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  code           String          @unique
  description    String
  version        String          @default("1.0.0")
  enabled        Boolean         @default(true)
  category       String
  rulesCount     Int             @default(0)
  extractionMode ExtractionMode  @default(CHEERIO)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("agent_modules")
}

model AgentDefinition {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String          @unique
  systemPrompt String
  targetNorm   String
  defaultMode  ExtractionMode  @default(CHEERIO)
  temperature  Float           @default(0.2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("agent_definitions")
}

model AuditReport {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  clientId        String         @db.ObjectId
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targetUrl       String
  extractionMode  ExtractionMode @default(CHEERIO)
  verdict         Verdict        @default(PARCIALMENTE_CONFORME)
  score           Int            @default(0)
  summary         String
  rawContent      String?
  cleanMarkdown   String?
  tokensSaved     Int            @default(0)
  executionTimeMs Int            @default(0)
  status          AuditStatus    @default(PENDING)
  violations      Violation[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([clientId, status, createdAt])
  @@map("audit_reports")
}

model Violation {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  auditReportId    String       @db.ObjectId
  auditReport      AuditReport  @relation(fields: [auditReportId], references: [id], onDelete: Cascade)
  normArticle      String
  normCode         String
  severity         RuleSeverity @default(MEDIA)
  detectedText     String
  correctiveAdvice String
  resolved         Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([auditReportId, severity])
  @@map("violations")
}

model SystemLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  level         String   // INFO, WARN, ERROR, DEBUG
  message       String
  module        String
  correlationId String?
  details       String?
  createdAt     DateTime @default(now())

  @@index([level, createdAt])
  @@map("system_logs")
}

