datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AUDITOR
  CLIENT
  VIEWER
}

enum ClientStatus {
  ATIVO
  INATIVO
  PENDENTE
  SUSPENSO
}

enum AuditStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum RuleSeverity {
  LEVE
  MEDIA
  GRAVE
  CRITICA
}

enum ExtractionMode {
  PUPPETEER
  CHEERIO
  FALLBACK_AI
  MCP
  FIRECRAWL
  DATALINK
}

enum Verdict {
  CONFORME
  PARCIALMENTE_CONFORME
  NAO_CONFORME
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String?
  name         String
  role         Role      @default(CLIENT)
  clientId     String?   @db.ObjectId
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt

  @@map("users")
}

model Client {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  tradeName         String?
  cnpj              String?       @unique
  crmResponsavel    String?
  crmUf             String?
  rqeResponsavel    String?
  especialidade     String?
  websiteUrl        String?
  instagramHandle   String?
  status            ClientStatus  @default(ATIVO)
  phone             String?
  email             String?
  users             User[]
  auditReports      AuditReport[]
  scrapedData       ClientScrapedData[]
  createdAt         DateTime?     @default(now())
  updatedAt         DateTime?     @updatedAt

  @@map("clients")
}

model AgentModule {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  code                String?         @unique
  description         String?
  version             String          @default("1.0.0")
  enabled             Boolean         @default(true)
  category            String          @default("DEONTOLOGIA_MEDICA")
  rulesCount          Int             @default(0)
  extractionMode      ExtractionMode  @default(CHEERIO)
  tags                String[]        @default(["CFM"])
  targetNorms         String[]        @default([])
  systemPrompt        String?
  clientId            String?         @db.ObjectId
  regulatoryFramework String?         @default("CFM (Resolução 2.336/2023)")
  cronSchedule        String?         @default("0 */6 * * *")
  targetUrl           String?
  createdAt           DateTime?       @default(now())
  updatedAt           DateTime?       @updatedAt

  @@map("agent_modules")
}

model AgentDefinition {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String          @unique
  systemPrompt String
  targetNorm   String
  defaultMode  ExtractionMode  @default(CHEERIO)
  temperature  Float           @default(0.2)
  createdAt    DateTime?       @default(now())
  updatedAt    DateTime?       @updatedAt

  @@map("agent_definitions")
}

model AuditReport {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  clientId        String?        @db.ObjectId
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targetUrl       String?
  extractionMode  ExtractionMode @default(CHEERIO)
  verdict         Verdict        @default(PARCIALMENTE_CONFORME)
  score           Int?           @default(0)
  summary         String?
  rawContent      String?
  cleanMarkdown   String?
  tokensSaved     Int?           @default(0)
  promptTokens    Int?           @default(0)
  completionTokens Int?          @default(0)
  totalTokens     Int?           @default(0)
  sourcesUsed     String[]       @default([])
  aiModelUsed     String?
  executionTimeMs Int?           @default(0)
  status          AuditStatus    @default(PENDING)
  violations      Violation[]
  createdAt       DateTime?      @default(now())
  updatedAt       DateTime?      @updatedAt

  @@index([clientId, status, createdAt])
  @@map("audit_reports")
}

model Violation {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  auditReportId    String       @db.ObjectId
  auditReport      AuditReport  @relation(fields: [auditReportId], references: [id], onDelete: Cascade)
  normArticle      String?
  normCode         String?
  severity         RuleSeverity @default(MEDIA)
  detectedText     String?
  correctiveAdvice String?
  resolved         Boolean      @default(false)
  createdAt        DateTime?    @default(now())

  @@index([auditReportId, severity])
  @@map("violations")
}

model SystemLog {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  level         String    // INFO, WARN, ERROR, DEBUG
  message       String
  module        String
  correlationId String?
  details       String?
  createdAt     DateTime? @default(now())

  @@index([level, createdAt])
  @@map("system_logs")
}

model ScrapedPage {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  url               String    @unique
  title             String
  cleanMarkdown     String
  rawLength         Int       @default(0)
  tokensCount       Int       @default(0)
  tags              String[]  // CFM, LGPD, ANVISA, ANS
  extractedEntities String?   // Serialized JSON with entities
  createdAt         DateTime? @default(now())
  updatedAt         DateTime? @updatedAt

  @@index([tags])
  @@index([tags, createdAt])
  @@map("scraped_pages")
}

model ClientScrapedData {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  clientId          String         @db.ObjectId
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url               String
  title             String?
  cleanMarkdown     String
  rawLength         Int            @default(0)
  tokensCount       Int            @default(0)
  extractionMode    ExtractionMode @default(CHEERIO)
  detectedTags      String[]       @default([])
  extractedEntities String?
  status            String         @default("COMPLETED")
  createdAt         DateTime?      @default(now())
  updatedAt         DateTime?      @updatedAt

  @@index([clientId, createdAt])
  @@map("client_scraped_data")
}

model AiModelConfig {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  provider    String    // gemini, ollama, heuristic
  modelId     String    // gemini-2.0-flash, qwen2.5:7b, regex-heuristic-v1
  baseUrl     String?   // URL para Ollama local ou endpoint customizado
  apiKey      String?   // Chave opcional customizada
  temperature Float     @default(0.2)
  maxTokens   Int       @default(2048)
  isActive    Boolean   @default(false)
  isDefault   Boolean   @default(false)
  description String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([provider, isActive])
  @@map("ai_model_configs")
}

