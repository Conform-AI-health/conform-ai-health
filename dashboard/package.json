{
  "name": "dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "ConformIA - Backend API REST, Prisma ORM, BullMQ Worker e Inteligência Regulatória",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:cleanup": "tsx src/scripts/cleanupScrapedPages.ts",
    "rag:reindex": "node dist/scripts/reindexNormEmbeddings.js",
    "rag:reindex:dev": "tsx src/scripts/reindexNormEmbeddings.ts",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx src/shared/autoMigrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@mendable/firecrawl-js": "^4.52.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.8",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pdf-parse": "^2.4.5",
    "prisma": "^5.22.0",
    "puppeteer": "^23.11.1",
    "resend": "^6.37.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
