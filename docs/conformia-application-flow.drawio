        </mxCell>

        <!-- ========================================== -->
        <!-- SWIMLANE 2: BACKEND CONTROLLERS & API -->
        <!-- ========================================== -->
        <mxCell id="lane_backend" value="2. CAMADA BACKEND API REST &amp;amp; CONTROLADORES (Express + TypeScript + RBAC + Zod)" style="swimlane;html=1;startSize=35;rounded=1;arcSize=10;fillColor=#0B1329;strokeColor=#6366F1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#818CF8;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="2100" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="ctrl_auth" value="&lt;b style='color:#818CF8;'&gt;Auth &amp;amp; RBAC Middleware&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;JWT Validation&lt;br&gt;Roles: ADMIN, AUDITOR, CLIENT&lt;br&gt;Tenant Isolation Estrito&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080D1A;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="lane_backend">
          <mxGeometry x="40" y="55" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="ctrl_client" value="&lt;b style='color:#38BDF8;'&gt;ClientController&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;POST /clients/:id/scrape&lt;br&gt;GET /clients/:id/scraped-data&lt;br&gt;Emite log [CLIENT_EXTRACTION]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080D1A;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="lane_backend">
          <mxGeometry x="310" y="55" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="ctrl_agent" value="&lt;b style='color:#10B981;'&gt;AgentController&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;POST /agents/:id/run&lt;br&gt;Recebe { clientId, url, skill, mode }&lt;br&gt;Registra log [COCKPIT] no MongoDB&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080D1A;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="lane_backend">
          <mxGeometry x="610" y="55" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="ctrl_queue_dispatch" value="&lt;b style='color:#F59E0B;'&gt;Despachador de Execução&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Enfileira no BullMQ (Redis)&lt;br&gt;ou Fallback Síncrono Imediato&lt;br&gt;(Resiliência sem paradas)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#1E1B4B;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="lane_backend">
          <mxGeometry x="940" y="45" width="210" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="ctrl_report" value="&lt;b style='color:#34D399;'&gt;ReportController&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;GET /reports (Paginação)&lt;br&gt;GET /reports/:id/export&lt;br&gt;Tratamento defensivo null-safe&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080D1A;strokeColor=#34D399;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="lane_backend">
          <mxGeometry x="1230" y="55" width="230" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="ctrl_telemetry" value="&lt;b style='color:#4ADE80;'&gt;TelemetryController&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;GET /system/telemetry&lt;br&gt;Stream de SystemLogs (take: 100)&lt;br&gt;Métricas Agregadas de Tokens&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080D1A;strokeColor=#4ADE80;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="lane_backend">
          <mxGeometry x="1540" y="55" width="250" height="90" as="geometry"/>
        </mxCell>

        <!-- ========================================== -->
