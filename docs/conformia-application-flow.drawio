  <diagram id="conformia-architecture-flow" name="Fluxo da Aplicação ConformIA">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" background="#080D1A" math="0" shadow="1">
