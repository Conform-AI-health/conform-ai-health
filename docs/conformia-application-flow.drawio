        <mxCell id="scraper_puppeteer" value="&lt;b style='color:#F472B6;'&gt;Puppeteer Engine&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#CBD5E1;'&gt;Headless Chromium SPA&lt;br&gt;Renderização JS Dinâmica&lt;br&gt;Captura de DOM em Tempo Real&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080D1A;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="lane_extraction">
