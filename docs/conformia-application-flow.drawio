        <mxCell id="ui_extract_modal" value="&lt;b style='color:#F59E0B;'&gt;Modal Coleta Digital&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#CBD5E1;'&gt;Scraping Web / Datalink / MCP&lt;br&gt;Salva em ClientScrapedData&lt;br&gt;(Sem poluir normas)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E1B4B;strokeColor=#818CF8;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="lane_frontend">
          <mxGeometry x="310" y="55" width="210" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="ui_agents" value="&lt;b style='color:#A855F7;'&gt;Governança de Agentes &amp;amp; IA&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Módulos com Regras &amp;amp; Cron&lt;br&gt;Catálogo de Normas Vinculadas&lt;br&gt;CRUD Modelos no MongoDB&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080D1A;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="lane_frontend">
          <mxGeometry x="570" y="55" width="230" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="ui_cockpit" value="&lt;b style='color:#10B981;'&gt;Cockpit de Disparo Imediato&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Seleção de Agente + Clínica + URL&lt;br&gt;&lt;b style='color:#38BDF8;'&gt;Seletor de Skill / Persona IA&lt;/b&gt;&lt;br&gt;(CFM, LGPD, LLMOps, ANS, ANVISA)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="lane_frontend">
