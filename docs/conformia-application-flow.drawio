        </mxCell>

        <mxCell id="ui_clinics" value="&lt;b style='color:#38BDF8;'&gt;Gestão de Clínicas&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Cadastro CRM/RQE/UF&lt;br&gt;CRUD Completo (Modais)&lt;/span&gt;&lt;br&gt;&lt;b style='color:#10B981;'&gt;[Buscar Informações]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080D1A;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="lane_frontend">
