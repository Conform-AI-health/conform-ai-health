        <!-- ========================================== -->
        <mxCell id="lane_extraction" value="3. CAMADA DE EXTRAÇÃO POLIMÓRFICA &amp;amp; FILAS (ScraperService + BullMQ + Redis)" style="swimlane;html=1;startSize=35;rounded=1;arcSize=10;fillColor=#0B1329;strokeColor=#EC4899;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#F472B6;align=left;spacingLeft=15;" vertex="1" parent="1">
