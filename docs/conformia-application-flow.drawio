        <mxCell id="title" value="&lt;b style='font-size: 24px; color: #10B981;'&gt;ConformIA Health&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 13px; color: #94A3B8;'&gt;Arquitetura Integrada &amp;amp; Fluxo de Execução Deontológica (CFM 2.336/23, LGPD, ANVISA, ANS)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#0B132B;strokeColor=#1E293B;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="30" width="900" height="70" as="geometry"/>
        </mxCell>

        <!-- ========================================== -->
        <!-- SWIMLANE 1: FRONTEND / DASHBOARD WEB -->
        <!-- ========================================== -->
        <mxCell id="lane_frontend" value="1. CAMADA FRONTEND (React 18 + Vite + Tailwind CSS + Toast System)" style="swimlane;html=1;startSize=35;rounded=1;arcSize=10;fillColor=#0B1329;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#38BDF8;align=left;spacingLeft=15;" vertex="1" parent="1">
