          <mxGeometry x="1450" y="55" width="240" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="ui_terminal" value="&lt;b style='color:#4ADE80;'&gt;Terminal de Logs &amp;amp; Telemetria&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;Console Live (Auto-refresh 3s)&lt;br&gt;Logs [COCKPIT] [SCRAPER] [AI]&lt;br&gt;Prompt, Completion Tokens, Latência&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022C22;strokeColor=#4ADE80;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="lane_frontend">
