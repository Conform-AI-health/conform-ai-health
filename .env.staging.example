# ==============================================================================
# Conform.AI Health - Environment Configuration Template (STAGING / HOMOLOGAÇÃO)
# ==============================================================================
# REGRAS DE COMPLIANCE (LGPD & Segurança):
# 1. NUNCA compartilhe DATABASE_URL ou REDIS_PASSWORD de produção com Staging.
# 2. Utilize massa sintética / Golden Set deontológico em conformia_staging.
# 3. Mantenha RESEND_API_KEY vazia (ou chave de sandbox) para evitar disparo
#    acidental de e-mails para clínicas reais durante testes de regressão.
# ==============================================================================

# Ambiente e Portas Isoladas (evita colisão quando validado em host dedicado ou paralelo)
NODE_ENV=production
APP_ENV=staging
APP_VERSION=sha-staging
API_PORT=3334
WEB_PORT=3080
REDIS_PORT=6380
WORKER_HEALTH_PORT=3002

# MongoDB Isolado de Homologação (NUNCA apontar para produção)
DATABASE_URL=mongodb+srv://staging_user:troque_por_senha@cluster-staging.mongodb.net/conformia_staging?retryWrites=true&w=majority

# Redis & BullMQ Dedicado para Staging (mínimo 32 caracteres)
REDIS_PASSWORD=troque_por_senha_staging_redis_minimo_32_caracteres_aleatorios

# Autenticação JWT Criptográfica Exclusiva de Staging (mínimo 32 caracteres)
JWT_SECRET=troque_por_chave_jwt_staging_acesso_minimo_32_caracteres
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=troque_por_chave_jwt_staging_refresh_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Administrador Inicial de Homologação (mínimo 12 caracteres)
ADMIN_EMAIL=admin-staging@conformia.med.br
ADMIN_PASSWORD=troque_por_senha_admin_staging_forte_12chars

# Provedores de Inteligência Artificial
AI_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_staging_aqui
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_HOST=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Mensageria em Modo Sandbox (vazio em Staging evita envios reais externos)
RESEND_API_KEY=
EMAIL_FROM=Conform.AI Staging <staging-nao-responder@conformia.med.br>

# Scraping & Extração
EXTRACTION_MODE=CHEERIO
FIRECRAWL_API_KEY=

# Monitoramento & Métricas do Worker (/metrics)
MONITORING_API_KEY=troque_por_chave_monitoramento_staging_minimo_32_caracteres

# URLs e CORS Estrito de Staging (protegido via VPN / IP Allowlist / Basic Auth no Nginx)
FRONTEND_URL=https://staging.conformia.med.br
CORS_ORIGIN=https://staging.conformia.med.br

# Observabilidade Estruturada e Tracing OpenTelemetry (OTLP HTTP)
LOG_LEVEL=debug
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
