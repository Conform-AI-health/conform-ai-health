# ==============================================================================
# Conform.AI Health - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
API_PORT=3333
WEB_PORT=3000

# MongoDB Connection String (Atlas ou Réplica Local)
DATABASE_URL=mongodb://localhost:27017/conformia?retryWrites=true&w=majority

# Redis & BullMQ Configuration (Segurança Obrigatória - Sem Senhas Padrão)
# REDIS_PASSWORD DEVE ser definida com alta entropia (mínimo 32 caracteres)
REDIS_PORT=6379
REDIS_PASSWORD=DefinaSuaSenhaSeguraAqui123456789!

# Autenticação JWT Criptográfica
# JWT_SECRET e JWT_REFRESH_SECRET são mandatórias e devem ter ao menos 32 caracteres
JWT_SECRET=ChaveSuperSecretaJWTAcessoMinimo32Caracteres2026!
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=ChaveSuperSecretaJWTRefreshMinimo32Caracteres2026!
JWT_REFRESH_EXPIRES_IN=7d

# Provedores de Inteligência Artificial
AI_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_api_aqui
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Serviços de Mensageria e Notificações (Resend API)
RESEND_API_KEY=re_123456789_abcdef
EMAIL_FROM=Conform.AI Laudos <laudos@conformia.med.br>

# Scraping & Extração Limpa de Normas
EXTRACTION_MODE=CHEERIO
FIRECRAWL_API_KEY=fc-sua-chave-aqui

# Frontend e URLs de CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
