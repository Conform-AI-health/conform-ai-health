# ==============================================================================
# Conform.AI Health - Environment Configuration Template
# Preencha todas as variáveis com valores seguros antes de iniciar a aplicação.
# NUNCA comite arquivos .env contendo dados reais de produção no controle de versão.
# ==============================================================================

# Node Environment
NODE_ENV=production
API_PORT=3333
WEB_PORT=3000

# MongoDB Connection String (Atlas ou Réplica Local)
DATABASE_URL=mongodb://localhost:27017/conformia?retryWrites=true&w=majority

# Redis & BullMQ Configuration (Segurança Obrigatória - Sem Senhas Padrão)
# REDIS_PASSWORD DEVE ser definida com alta entropia (mínimo 32 caracteres)
REDIS_PORT=6379
REDIS_PASSWORD=troque_por_senha_forte_do_redis_minimo_32_caracteres_gerada_aleatoriamente

# Autenticação JWT Criptográfica
# JWT_SECRET e JWT_REFRESH_SECRET são mandatórias e devem ter ao menos 32 caracteres aleatórios
JWT_SECRET=troque_por_chave_secreta_jwt_acesso_minimo_32_caracteres
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=troque_por_chave_secreta_jwt_refresh_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Administrador Inicial do Sistema (Obrigatório em Produção: senha com mínimo 12 caracteres)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque_por_uma_senha_admin_forte_minimo_12_caracteres

# Provedores de Inteligência Artificial
AI_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_api_aqui
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Serviços de Mensageria e Notificações (Resend API)
RESEND_API_KEY=re_sua_chave_resend_api_aqui
EMAIL_FROM=Conform.AI Laudos <laudos@conformia.med.br>

# Scraping & Extração Limpa de Normas
EXTRACTION_MODE=CHEERIO
FIRECRAWL_API_KEY=fc-sua-chave-aqui

# Monitoramento e Métricas do Worker (/metrics) - Mandatório em Produção (T02)
MONITORING_API_KEY=troque_por_chave_secreta_de_monitoramento_minimo_32_caracteres

# Frontend e URLs de CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
